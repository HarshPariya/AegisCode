# ==============================================================================
# AEGISCODE — PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file, fill in all values, and set as environment variables
# on your deployment platform (Render, Vercel, etc.)
# NEVER commit actual secrets to version control.
# ==============================================================================

# --- Application ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Set to your actual deployed URLs:
BACKEND_URL=https://aegiscode-api.onrender.com
FRONTEND_URL=https://aegiscode.vercel.app

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_64_CHAR_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# MongoDB Atlas connection string (from Atlas dashboard)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/
MONGODB_DATABASE=aegiscode

# --- LLM Primary Provider ---
# Supported: groq | openai | gemini
MODEL_PROVIDER=groq
# Groq: llama-3.3-70b-versatile (stable, high throughput)
# OpenAI: gpt-4o | gpt-4o-mini
# Gemini: gemini-1.5-pro | gemini-1.5-flash
MODEL_NAME=llama-3.3-70b-versatile
MODEL_API_KEY=REPLACE_WITH_API_KEY
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3
MODEL_RETRY_DELAY_SECONDS=2.0
MODEL_MAX_TOKENS_PER_TASK=100000

# --- LLM Fallback Provider (optional but recommended for production) ---
# Activated automatically when primary provider returns 429 or fails
# MODEL_FALLBACK_PROVIDER=gemini
# MODEL_FALLBACK_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
# MODEL_FALLBACK_NAME=gemini-1.5-flash

# --- Sandbox (REQUIRED for production) ---
# E2B cloud sandbox — get free API key at https://e2b.dev
SANDBOX_PROVIDER=e2b
E2B_API_KEY=REPLACE_WITH_E2B_API_KEY
E2B_TEMPLATE=base
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_ALLOW_INTERNET=true

# --- GitHub App ---
# Create GitHub App at https://github.com/settings/apps
# Required permissions: Contents R/W, Pull Requests R/W, Metadata R
GITHUB_APP_ID=REPLACE_WITH_GITHUB_APP_ID
GITHUB_APP_SLUG=aegiscode
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
# Private key: base64-encoded PEM, or set as multiline in deployment platform
GITHUB_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_PRIVATE_KEY

# --- Google OAuth (for social login) ---
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# --- Policy ---
REQUIRE_APPROVAL_FOR_COMMITS=false
REQUIRE_APPROVAL_FOR_PULL_REQUESTS=false
MAX_REPAIR_ATTEMPTS=3

# --- Observability (optional) ---
ENABLE_OTEL=false
OTEL_SERVICE_NAME=aegiscode-engine
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint:4317
