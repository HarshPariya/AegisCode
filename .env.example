# ==============================================================================
# AEGISCODE CONFIGURATION (.env.example)
# Copy this file to .env and provide your specific credentials
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SECRET_KEY=replace-with-at-least-32-characters-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=aegiscode

# Primary LLM Provider (Groq / OpenAI / Gemini)
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
MODEL_API_KEY=gsk_your_groq_api_key_here
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=3
MODEL_RETRY_DELAY_SECONDS=2.0
MODEL_MAX_TOKENS_PER_TASK=100000

# Fallback LLM Provider (Optional)
MODEL_FALLBACK_PROVIDER=gemini
MODEL_FALLBACK_API_KEY=your_gemini_api_key_here
MODEL_FALLBACK_NAME=gemini-1.5-flash

# Sandbox Isolation (e2b for cloud micro-VMs, local_process for local dev)
SANDBOX_PROVIDER=e2b
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_ALLOW_INTERNET=false

# E2B Cloud Micro-VMs (Get free key at https://e2b.dev)
E2B_API_KEY=e2b_your_e2b_api_key_here
E2B_TEMPLATE=base

# Workflow Guardrails
REQUIRE_APPROVAL_FOR_COMMITS=false
REQUIRE_APPROVAL_FOR_PULL_REQUESTS=false
MAX_REPAIR_ATTEMPTS=3

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

OTEL_SERVICE_NAME=aegiscode-engine
